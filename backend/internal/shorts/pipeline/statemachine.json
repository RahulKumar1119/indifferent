{
  "Comment": "AI Shorts Pipeline: Transcribe → Rank → Render (Fargate Spot fan-out) → Complete",
  "StartAt": "UpdateStatus_Transcribing",
  "States": {
    "UpdateStatus_Transcribing": {
      "Type": "Task",
      "Resource": "${StatusUpdaterShortsArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "status": "transcribing"
      },
      "ResultPath": null,
      "Next": "StartTranscription"
    },
    "StartTranscription": {
      "Type": "Task",
      "Resource": "${ShortsTranscribeLambdaArn}",
      "TimeoutSeconds": 180,
      "Parameters": {
        "mode": "start",
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "sourceKey.$": "$.sourceKey"
      },
      "ResultPath": "$.transcribe",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "WaitForTranscription"
    },
    "WaitForTranscription": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "CheckTranscription"
    },
    "CheckTranscription": {
      "Type": "Task",
      "Resource": "${ShortsTranscribeLambdaArn}",
      "TimeoutSeconds": 180,
      "Parameters": {
        "mode": "poll",
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "jobName.$": "$.transcribe.jobName"
      },
      "ResultPath": "$.transcribeStatus",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "TranscriptionDone?"
    },
    "TranscriptionDone?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.transcribeStatus.state",
          "StringEquals": "IN_PROGRESS",
          "Next": "WaitForTranscription"
        },
        {
          "Variable": "$.transcribeStatus.state",
          "StringEquals": "FAILED",
          "Next": "TranscriptionFailedError"
        },
        {
          "Variable": "$.transcribeStatus.state",
          "StringEquals": "COMPLETED",
          "Next": "ThumbnailsForVideo?"
        }
      ],
      "Default": "TranscriptionStatusUnknownError"
    },
    "TranscriptionFailedError": {
      "Type": "Pass",
      "Comment": "MarkFailed reads $.error; a Choice branch cannot set it, so this does.",
      "Result": {
        "Error": "TranscriptionFailed",
        "Cause": "Transcription failed."
      },
      "ResultPath": "$.error",
      "Next": "MarkFailed"
    },
    "TranscriptionStatusUnknownError": {
      "Type": "Pass",
      "Comment": "MarkFailed reads $.error; a Choice default cannot set it, so this does.",
      "Result": {
        "Error": "TranscriptionStatusUnknown",
        "Cause": "Transcription returned an unexpected status."
      },
      "ResultPath": "$.error",
      "Next": "MarkFailed"
    },
    "ThumbnailsForVideo?": {
      "Type": "Choice",
      "Comment": "Thumbnails need a picture, so audio uploads skip them (issue #77).",
      "Choices": [
        {
          "Or": [
            { "Variable": "$.sourceKey", "StringMatches": "*.mp4" },
            { "Variable": "$.sourceKey", "StringMatches": "*.MP4" },
            { "Variable": "$.sourceKey", "StringMatches": "*.mov" },
            { "Variable": "$.sourceKey", "StringMatches": "*.MOV" }
          ],
          "Next": "StartThumbnails"
        }
      ],
      "Default": "UpdateStatus_Ranking"
    },
    "StartThumbnails": {
      "Type": "Task",
      "Comment": "Fire and forget: starts AI thumbnail generation alongside the pipeline. Any failure here carries on to ranking, because thumbnails must never affect the clips. The fixed execution name makes this run once per job.",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn": "${ThumbnailsStateMachineArn}",
        "Name.$": "States.Format('thumbnails-{}-auto', $.jobId)",
        "Input": {
          "jobId.$": "$.jobId",
          "userId.$": "$.userId",
          "sourceKey.$": "$.sourceKey",
          "transcriptKey.$": "$.transcribeStatus.transcriptKey",
          "sourceDuration.$": "$.sourceDuration"
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.thumbnailsError",
          "Next": "UpdateStatus_Ranking"
        }
      ],
      "Next": "UpdateStatus_Ranking"
    },
    "UpdateStatus_Ranking": {
      "Type": "Task",
      "Resource": "${StatusUpdaterShortsArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "status": "ranking"
      },
      "ResultPath": null,
      "Next": "Rank"
    },
    "Rank": {
      "Type": "Task",
      "Resource": "${ShortsRankLambdaArn}",
      "TimeoutSeconds": 900,
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "sourceKey.$": "$.sourceKey",
        "transcriptKey.$": "$.transcribeStatus.transcriptKey",
        "sourceDuration.$": "$.sourceDuration"
      },
      "ResultPath": "$.rank",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "AnySegments?"
    },
    "AnySegments?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.rank.clips[0]",
          "IsPresent": true,
          "Next": "UpdateStatus_Rendering"
        }
      ],
      "Default": "NoSegmentsError"
    },
    "NoSegmentsError": {
      "Type": "Pass",
      "Comment": "MarkFailed reads $.error; a Choice default cannot set it, so this does.",
      "Result": {
        "Error": "NoSegments",
        "Cause": "No segments were found to turn into clips."
      },
      "ResultPath": "$.error",
      "Next": "MarkFailed"
    },
    "UpdateStatus_Rendering": {
      "Type": "Task",
      "Resource": "${StatusUpdaterShortsArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "status": "rendering"
      },
      "ResultPath": null,
      "Next": "RenderClips"
    },
    "RenderClips": {
      "Type": "Map",
      "ItemsPath": "$.rank.clips",
      "MaxConcurrency": 3,
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "sourceKey.$": "$.sourceKey",
        "transcriptKey.$": "$.transcribeStatus.transcriptKey",
        "clip.$": "$$.Map.Item.Value"
      },
      "Iterator": {
        "StartAt": "RenderOnSpot",
        "States": {
          "RenderOnSpot": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "TimeoutSeconds": 1800,
            "Parameters": {
              "Cluster": "${EcsClusterArn}",
              "TaskDefinition": "${ShortsRenderTaskDefArn}",
              "CapacityProviderStrategy": [
                { "CapacityProvider": "FARGATE_SPOT", "Weight": 1 }
              ],
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetIds}"],
                  "AssignPublicIp": "ENABLED",
                  "SecurityGroups": ["${SecurityGroupId}"]
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "shorts-render",
                    "Environment": [
                      { "Name": "JOB_ID", "Value.$": "$.jobId" },
                      { "Name": "USER_ID", "Value.$": "$.userId" },
                      { "Name": "SOURCE_KEY", "Value.$": "$.sourceKey" },
                      { "Name": "TRANSCRIPT_KEY", "Value.$": "$.transcriptKey" },
                      { "Name": "CLIP_ID", "Value.$": "$.clip.clipId" },
                      { "Name": "CLIP_START", "Value.$": "States.Format('{}', $.clip.start)" },
                      { "Name": "CLIP_END", "Value.$": "States.Format('{}', $.clip.end)" },
                      { "Name": "CLIP_RANK", "Value.$": "States.Format('{}', $.clip.rank)" }
                    ]
                  }
                ]
              }
            },
            "Retry": [
              {
                "ErrorEquals": ["ECS.AmazonECSException", "States.TaskFailed"],
                "IntervalSeconds": 20,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.spotError",
                "Next": "RenderOnDemand"
              }
            ],
            "End": true
          },
          "RenderOnDemand": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "TimeoutSeconds": 1800,
            "Parameters": {
              "Cluster": "${EcsClusterArn}",
              "TaskDefinition": "${ShortsRenderTaskDefArn}",
              "CapacityProviderStrategy": [
                { "CapacityProvider": "FARGATE", "Weight": 1 }
              ],
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetIds}"],
                  "AssignPublicIp": "ENABLED",
                  "SecurityGroups": ["${SecurityGroupId}"]
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "shorts-render",
                    "Environment": [
                      { "Name": "JOB_ID", "Value.$": "$.jobId" },
                      { "Name": "USER_ID", "Value.$": "$.userId" },
                      { "Name": "SOURCE_KEY", "Value.$": "$.sourceKey" },
                      { "Name": "TRANSCRIPT_KEY", "Value.$": "$.transcriptKey" },
                      { "Name": "CLIP_ID", "Value.$": "$.clip.clipId" },
                      { "Name": "CLIP_START", "Value.$": "States.Format('{}', $.clip.start)" },
                      { "Name": "CLIP_END", "Value.$": "States.Format('{}', $.clip.end)" },
                      { "Name": "CLIP_RANK", "Value.$": "States.Format('{}', $.clip.rank)" }
                    ]
                  }
                ]
              }
            },
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "RenderFailed"
              }
            ],
            "End": true
          },
          "RenderFailed": {
            "Type": "Fail",
            "Error": "RenderFailed",
            "Cause": "Clip rendering failed on both Spot and on-demand capacity"
          }
        }
      },
      "ResultPath": "$.renderResults",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "MarkCompleted"
    },
    "MarkCompleted": {
      "Type": "Task",
      "Resource": "${StatusUpdaterShortsArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "status": "completed",
        "clips.$": "$.rank.clips"
      },
      "ResultPath": null,
      "Next": "NotifyCompleted"
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "${StatusUpdaterShortsArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "status": "failed",
        "error.$": "$.error"
      },
      "ResultPath": null,
      "Next": "NotifyFailed"
    },
    "NotifyCompleted": {
      "Type": "Task",
      "Comment": "Best-effort email. Any failure here continues to NotifyEnd; the job outcome is already recorded.",
      "Resource": "${NotifierArn}",
      "Parameters": {
        "kind": "shorts",
        "outcome": "completed",
        "userId.$": "$.userId",
        "jobId.$": "$.jobId",
        "executionId.$": "$$.Execution.Id"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Throttled"],
          "IntervalSeconds": 10,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notifyError",
          "Next": "NotifyEnd"
        }
      ],
      "End": true
    },
    "NotifyFailed": {
      "Type": "Task",
      "Comment": "Best-effort email. Any failure here continues to NotifyEnd; the job outcome is already recorded.",
      "Resource": "${NotifierArn}",
      "Parameters": {
        "kind": "shorts",
        "outcome": "failed",
        "userId.$": "$.userId",
        "jobId.$": "$.jobId",
        "executionId.$": "$$.Execution.Id"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Throttled"],
          "IntervalSeconds": 10,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notifyError",
          "Next": "NotifyEnd"
        }
      ],
      "End": true
    },
    "NotifyEnd": {
      "Type": "Pass",
      "End": true
    }
  }
}
