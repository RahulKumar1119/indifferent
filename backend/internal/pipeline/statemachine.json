{
  "Comment": "TXT-to-Video Pipeline: Parser → SlideGen → Narrator → Renderer",
  "StartAt": "UpdateStatus_Parsing",
  "States": {
    "UpdateStatus_Parsing": {
      "Type": "Task",
      "Resource": "${StatusUpdaterArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "status": "parsing"
      },
      "ResultPath": null,
      "Next": "ParseTXT"
    },
    "ParseTXT": {
      "Type": "Task",
      "Resource": "${ParserLambdaArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "userId.$": "$.userId",
        "s3Key.$": "$.s3Key"
      },
      "ResultPath": "$.parserOutput",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "UpdateStatus_GeneratingSlides"
    },
    "UpdateStatus_GeneratingSlides": {
      "Type": "Task",
      "Resource": "${StatusUpdaterArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "status": "generating_slides"
      },
      "ResultPath": null,
      "Next": "GenerateSlides"
    },
    "GenerateSlides": {
      "Type": "Task",
      "Resource": "${SlideGenLambdaArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "jsonKey.$": "$.parserOutput.s3Key",
        "template.$": "$.template",
        "designOptions.$": "$.designOptions"
      },
      "ResultPath": "$.slideGenOutput",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "UpdateStatus_Narrating"
    },
    "UpdateStatus_Narrating": {
      "Type": "Task",
      "Resource": "${StatusUpdaterArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "status": "narrating"
      },
      "ResultPath": null,
      "Next": "Narrate"
    },
    "Narrate": {
      "Type": "Task",
      "Resource": "${NarratorLambdaArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "jsonKey.$": "$.parserOutput.s3Key",
        "voice.$": "$.voice"
      },
      "ResultPath": "$.narratorOutput",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "UpdateStatus_Rendering"
    },
    "UpdateStatus_Rendering": {
      "Type": "Task",
      "Resource": "${StatusUpdaterArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "status": "rendering"
      },
      "ResultPath": null,
      "Next": "Render"
    },
    "Render": {
      "Type": "Task",
      "Resource": "${RendererLambdaArn}",
 "Parameters": {
  "projectId.$": "$.projectId",
  "slideKeys.$": "$.slideGenOutput.slideKeys",
  "audioKeys.$": "$.narratorOutput.audioKeys",
  "jsonKey.$": "$.parserOutput.s3Key",
  "logoKey.$": "$.logoKey"
 },
      "ResultPath": "$.rendererOutput",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "MarkCompleted"
    },
    "MarkCompleted": {
      "Type": "Task",
      "Resource": "${StatusUpdaterArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "status": "completed",
        "videoKey.$": "$.rendererOutput.videoKey",
        "thumbnailKey.$": "$.rendererOutput.thumbnailKey"
      },
      "ResultPath": null,
      "Next": "NotifyCompleted"
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "${StatusUpdaterArn}",
      "Parameters": {
        "projectId.$": "$.projectId",
        "status": "failed",
        "error.$": "$.error"
      },
      "ResultPath": null,
      "Next": "NotifyFailed"
    },
    "NotifyCompleted": {
      "Type": "Task",
      "Comment": "Best-effort email. Any failure here continues to NotifyEnd; the job outcome is already recorded.",
      "Resource": "${NotifierArn}",
      "Parameters": {
        "kind": "quiz",
        "outcome": "completed",
        "userId.$": "$.userId",
        "projectId.$": "$.projectId",
        "executionId.$": "$$.Execution.Id"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Throttled"],
          "IntervalSeconds": 10,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notifyError",
          "Next": "NotifyEnd"
        }
      ],
      "End": true
    },
    "NotifyFailed": {
      "Type": "Task",
      "Comment": "Best-effort email. Any failure here continues to NotifyEnd; the job outcome is already recorded.",
      "Resource": "${NotifierArn}",
      "Parameters": {
        "kind": "quiz",
        "outcome": "failed",
        "userId.$": "$.userId",
        "projectId.$": "$.projectId",
        "executionId.$": "$$.Execution.Id"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Throttled"],
          "IntervalSeconds": 10,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notifyError",
          "Next": "NotifyEnd"
        }
      ],
      "End": true
    },
    "NotifyEnd": {
      "Type": "Pass",
      "End": true
    }
  }
}
