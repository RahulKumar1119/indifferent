# Copy to .env and fill in real values
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
JWT_SECRET=generate-with-openssl-rand-hex-32

# Story2Shorts stock media (issue #162). Pixabay keys are free: https://pixabay.com/api/docs/
# Pexels (https://www.pexels.com/api/) has paused new key issuance since about Oct 2026, so only
# someone with an existing key can set PEXELS_API_KEY. The service works on Pixabay alone.
# Set one or both; a provider without a key is left out. Backend only: never expose these to the frontend.
PEXELS_API_KEY=your-pexels-key
PIXABAY_API_KEY=your-pixabay-key
